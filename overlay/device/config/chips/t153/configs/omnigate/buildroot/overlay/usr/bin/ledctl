#!/bin/sh

LED_ROOT="${LED_ROOT:-/sys/class/leds}"
RUN_DIR="${LEDCTL_RUN_DIR:-/run/ledctl}"
PID_FILE="${RUN_DIR}/worker.pid"
MODE_FILE="${RUN_DIR}/mode"
LOG_FILE="${LEDCTL_LOG_FILE:-/tmp/ledctl.log}"
MAX_BRIGHTNESS=255

usage()
{
	cat <<'EOF'
Usage:
  ledctl on <1|2|3|all>
  ledctl off <1|2|3|all>
  ledctl only <1|2|3>
  ledctl toggle <1|2|3>
  ledctl mode <flow|bounce|alternate|blink|heartbeat|dance> [interval_ms]
  ledctl stop
  ledctl status

Examples:
  ledctl on 1
  ledctl only 2
  ledctl mode flow 250
  ledctl mode heartbeat 400
  ledctl off all
EOF
}

led_path()
{
	case "$1" in
		1|led1|t153:led1) echo "${LED_ROOT}/t153:led1" ;;
		2|led2|t153:led2) echo "${LED_ROOT}/t153:led2" ;;
		3|led3|t153:led3) echo "${LED_ROOT}/t153:led3" ;;
		*) return 1 ;;
	esac
}

wait_for_leds()
{
	count=0
	while [ ! -w "${LED_ROOT}/t153:led1/brightness" ] ||
	      [ ! -w "${LED_ROOT}/t153:led2/brightness" ] ||
	      [ ! -w "${LED_ROOT}/t153:led3/brightness" ]; do
		count=$((count + 1))
		[ "${count}" -ge 50 ] && return 1
		usleep 100000
	done

	for led in 1 2 3; do
		path="$(led_path "${led}")"
		[ -w "${path}/trigger" ] && echo none > "${path}/trigger"
	done
}

set_led_raw()
{
	path="$(led_path "$1")" || return 1
	case "$2" in
		0|off) value=0 ;;
		1|on) value=${MAX_BRIGHTNESS} ;;
		*) return 1 ;;
	esac
	[ -w "${path}/brightness" ] || return 1
	echo "${value}" > "${path}/brightness"
}

set_pattern()
{
	mask="$1"
	for led in 1 2 3; do
		bit=$((1 << (led - 1)))
		if [ $((mask & bit)) -ne 0 ]; then
			set_led_raw "${led}" 1
		else
			set_led_raw "${led}" 0
		fi
	done
}

sleep_ms()
{
	usleep $(($1 * 1000))
}

is_worker_pid()
{
	pid="$1"
	case "${pid}" in
		''|*[!0-9]*) return 1 ;;
	esac
	[ -r "/proc/${pid}/cmdline" ] || return 1
	tr '\000' ' ' < "/proc/${pid}/cmdline" 2>/dev/null |
		grep -q 'ledctl.*--worker'
}

stop_worker()
{
	if [ -r "${PID_FILE}" ]; then
		pid="$(cat "${PID_FILE}" 2>/dev/null)"
		if is_worker_pid "${pid}"; then
			kill "${pid}" 2>/dev/null || true
			count=0
			while is_worker_pid "${pid}"; do
				count=$((count + 1))
				[ "${count}" -ge 40 ] && break
				usleep 50000
			done
			if is_worker_pid "${pid}"; then
				kill -KILL "${pid}" 2>/dev/null || true
			fi
		fi
	fi
	rm -f "${PID_FILE}" "${MODE_FILE}"
}

validate_interval()
{
	case "$1" in
		''|*[!0-9]*) return 1 ;;
	esac
	[ "$1" -ge 30 ] && [ "$1" -le 60000 ]
}

validate_mode()
{
	case "$1" in
		flow|bounce|alternate|blink|heartbeat|dance) return 0 ;;
		*) return 1 ;;
	esac
}

run_worker()
{
	mode="$1"
	interval="$2"

	wait_for_leds || exit 1
	trap 'set_pattern 0; exit 0' INT TERM HUP

	case "${mode}" in
		flow)
			while :; do
				for pattern in 1 2 4; do
					set_pattern "${pattern}"
					sleep_ms "${interval}"
				done
			done
			;;
		bounce)
			while :; do
				for pattern in 1 2 4 2; do
					set_pattern "${pattern}"
					sleep_ms "${interval}"
				done
			done
			;;
		alternate)
			while :; do
				set_pattern 5
				sleep_ms "${interval}"
				set_pattern 2
				sleep_ms "${interval}"
			done
			;;
		blink)
			while :; do
				set_pattern 7
				sleep_ms "${interval}"
				set_pattern 0
				sleep_ms "${interval}"
			done
			;;
		heartbeat)
			while :; do
				set_pattern 7
				sleep_ms 80
				set_pattern 0
				sleep_ms 100
				set_pattern 7
				sleep_ms 80
				set_pattern 0
				sleep_ms "${interval}"
			done
			;;
		dance)
			while :; do
				for pattern in 1 3 2 6 4 5 7 0; do
					set_pattern "${pattern}"
					sleep_ms "${interval}"
				done
			done
			;;
	esac
}

start_mode()
{
	mode="$1"
	interval="${2:-250}"

	validate_mode "${mode}" || {
		echo "ledctl: unknown mode '${mode}'" >&2
		usage >&2
		return 1
	}
	validate_interval "${interval}" || {
		echo "ledctl: interval must be between 30 and 60000 ms" >&2
		return 1
	}
	wait_for_leds || {
		echo "ledctl: LED devices are not ready" >&2
		return 1
	}
	stop_worker
	mkdir -p "${RUN_DIR}" || return 1
	nohup "$0" --worker "${mode}" "${interval}" >"${LOG_FILE}" 2>&1 &
	pid=$!
	echo "${pid}" > "${PID_FILE}"
	echo "${mode} ${interval}" > "${MODE_FILE}"
	echo "LED mode: ${mode}, interval: ${interval} ms"
}

manual_set()
{
	action="$1"
	target="$2"

	stop_worker
	wait_for_leds || {
		echo "ledctl: LED devices are not ready" >&2
		return 1
	}

	if [ "${target}" = "all" ]; then
		for led in 1 2 3; do
			set_led_raw "${led}" "${action}" || return 1
		done
	else
		set_led_raw "${target}" "${action}" || {
			echo "ledctl: LED must be 1, 2, 3 or all" >&2
			return 1
		}
	fi
}

show_status()
{
	if [ -r "${PID_FILE}" ] && is_worker_pid "$(cat "${PID_FILE}")"; then
		echo "mode: $(cat "${MODE_FILE}" 2>/dev/null)"
	else
		echo "mode: manual"
	fi
	for led in 1 2 3; do
		path="$(led_path "${led}")"
		if [ -r "${path}/brightness" ]; then
			value="$(cat "${path}/brightness")"
			[ "${value}" -eq 0 ] && state=off || state=on
			echo "led${led}: ${state} (${value})"
		else
			echo "led${led}: unavailable"
		fi
	done
}

case "$1" in
	--worker)
		run_worker "$2" "$3"
		;;
	mode)
		[ -n "$2" ] || { usage; exit 1; }
		start_mode "$2" "$3"
		;;
	on|off)
		[ -n "$2" ] || { usage; exit 1; }
		manual_set "$1" "$2"
		;;
	only)
		[ -n "$2" ] || { usage; exit 1; }
		stop_worker
		wait_for_leds || exit 1
		case "$2" in
			1|led1|t153:led1) set_pattern 1 ;;
			2|led2|t153:led2) set_pattern 2 ;;
			3|led3|t153:led3) set_pattern 4 ;;
			*) echo "ledctl: LED must be 1, 2 or 3" >&2; exit 1 ;;
		esac
		;;
	toggle)
		[ -n "$2" ] || { usage; exit 1; }
		stop_worker
		wait_for_leds || exit 1
		path="$(led_path "$2")" || {
			echo "ledctl: LED must be 1, 2 or 3" >&2
			exit 1
		}
		value="$(cat "${path}/brightness")"
		[ "${value}" -eq 0 ] && set_led_raw "$2" 1 || set_led_raw "$2" 0
		;;
	stop)
		stop_worker
		wait_for_leds && set_pattern 0
		;;
	status)
		show_status
		;;
	help|-h|--help)
		usage
		;;
	*)
		usage
		exit 1
		;;
esac
