#!/bin/sh
#
# Start the adbd....
#

# config adb serialnumber for adb devices
adb_serialnumber=/etc/.adb_sn

disable_udc="/etc/.disable_udc"
udc_config=/sys/kernel/config/usb_gadget/g1/UDC

otg_role_file="/sys/devices/platform/soc/usbc0/otg_role"
usb_device_file="/sys/devices/platform/soc/usbc0/usb_device"
hardware_type=`cat /proc/cmdline | tr ' ' '\n' | grep 'hardware' | awk -F "=" '{print $2}'`

enable_udc()
{
	while [ 1 ];do
		udc=`ls /sys/class/udc 2>/dev/null`
		isudc=`cat $udc_config 2>/dev/null`
		if [ "x$isudc" = "x" ] && [ -f $udc_config ]; then
			echo $udc > $udc_config
		fi
		sleep 1
		if [ -f $disable_udc ];then
			rm $disable_udc
			break
		fi
	done
}

unbind_udc()
{
	if [ -f "$udc_config" ] && [ -n "`cat "$udc_config" 2>/dev/null`" ]; then
		echo "" > "$udc_config"
	fi
}

stop_adb()
{
	unbind_udc
	killall adbd 2>/dev/null
	# A stale FunctionFS mount keeps the old descriptors and commonly leaves
	# the Windows transport in offline state after an adbd restart.
	if mount | grep -q 'on /dev/usb-ffs/adb type functionfs'; then
		tries=0
		while ! umount /dev/usb-ffs/adb 2>/dev/null; do
			tries=$((tries + 1))
			[ "$tries" -ge 10 ] && return 1
			busybox usleep 100000
		done
	fi
	return 0
}

start_adb()
{
	serialnumber=$1
	if [ "x$serialnumber" = "x" ];then
		serialnumber="0402101560"
	fi
	printf "Starting adb: "
	# for adbd compatibilities
	mkdir -p /system/
	mkdir -p /system/bin
	if [ ! -f /system/bin/sh ];then
		ln -s /bin/sh /system/bin/sh
	fi

	# config ptmx
	mkdir -p /dev/pts
	mount | grep -q 'on /dev/pts type devpts' || mount -t devpts none /dev/pts

	# config adb function
	mount -t configfs none /sys/kernel/config > /dev/null 2>&1
	mkdir -p /sys/kernel/config/usb_gadget/g1
	# The vendor UDC may already be bound before adbd has published its
	# FunctionFS descriptors. Windows then keeps an enumerated transport in
	# "offline" state. Always configure FunctionFS while the UDC is detached.
	if [ -f "$udc_config" ] && [ -n "`cat "$udc_config" 2>/dev/null`" ]; then
		echo "" > "$udc_config"
	fi
	echo "0x18d1" > /sys/kernel/config/usb_gadget/g1/idVendor
	echo "0x4ee7" > /sys/kernel/config/usb_gadget/g1/idProduct
	mkdir -p /sys/kernel/config/usb_gadget/g1/strings/0x409
	echo "$serialnumber" > /sys/kernel/config/usb_gadget/g1/strings/0x409/serialnumber
	echo "Tina Linux" > /sys/kernel/config/usb_gadget/g1/strings/0x409/manufacturer
	echo "T153MX-OminiGate ADB" > /sys/kernel/config/usb_gadget/g1/strings/0x409/product
	mkdir -p /sys/kernel/config/usb_gadget/g1/functions/ffs.adb
	mkdir -p /sys/kernel/config/usb_gadget/g1/configs/c.1
	mkdir -p /sys/kernel/config/usb_gadget/g1/configs/c.1/strings/0x409
	echo 0xc0 > /sys/kernel/config/usb_gadget/g1/configs/c.1/bmAttributes
	echo 500 > /sys/kernel/config/usb_gadget/g1/configs/c.1/MaxPower
	ln -s /sys/kernel/config/usb_gadget/g1/functions/ffs.adb/ /sys/kernel/config/usb_gadget/g1/configs/c.1/ffs.adb > /dev/null 2>&1
	mkdir -p /dev/usb-ffs
	mkdir -p /dev/usb-ffs/adb
	if ! mount | grep -q 'on /dev/usb-ffs/adb type functionfs'; then
		mount -o uid=2000,gid=2000 -t functionfs adb /dev/usb-ffs/adb/ || {
			echo "FAIL (FunctionFS mount)"
			return 1
		}
	fi

	# start adbd daemon
	adbd &
	tries=0
	while [ -z "`pidof adbd`" ]; do
		tries=$((tries + 1))
		[ "$tries" -ge 20 ] && break
		busybox usleep 100000
	done
	adb_pid=`pidof adbd`
	if [ -z "$adb_pid" ]; then
		echo "FAIL (adbd exited)"
		return 1
	fi
	sleep 1

	# Let adbd open ep0 and publish descriptors before presenting the gadget
	# to the host. This ordering is required for reliable Windows enumeration.
	sleep 1
	udc=`ls /sys/class/udc 2>/dev/null | head -n 1`
	if [ -n "$udc" ] && [ -z "`cat "$udc_config" 2>/dev/null`" ]; then
		echo "$udc" > "$udc_config"
	fi
	if [ -z "$udc" ] || [ "`cat "$udc_config" 2>/dev/null`" != "$udc" ]; then
		echo "FAIL (UDC bind)"
		kill "$adb_pid" 2>/dev/null
		return 1
	fi
	echo "OK"
}

case "$1" in
	start|"")
		if [ "x$hardware_type" = "xsun8iw11p1" ];then
			otg_role_file="/sys/devices/platform/soc@1c00000/soc@1c00000:usbc0@0/otg_role"
		elif [ "x$hardware_type" = "xsun8iw20p1" ];then
			otg_role_file="/sys/devices/platform/soc@3000000/soc@3000000:usbc0@0/otg_role"
		fi
		[ -f "$otg_role_file" ] && otg_role=`cat "$otg_role_file"`
		echo "usb0 current mode: $otg_role"
		if [ -f "$otg_role_file" ] && [ "x$otg_role" != "xusb_device" ];then
			# force switch usb0 to device mode
			echo "Starting switch usb0 to device mode."
			if [ "x$hardware_type" = "xsun8iw11p1" ];then
				usb_device_file="/sys/devices/platform/soc@1c00000/soc@1c00000:usbc0@0/usb_device"
			elif [ "x$hardware_type" = "xsun8iw20p1" ];then
				usb_device_file="/sys/devices/platform/soc@3000000/soc@3000000:usbc0@0/usb_device"
			fi
			[ -f "$usb_device_file" ] && cat $usb_device_file
		fi
		[ -f $adb_serialnumber ] && serialnumber=`cat $adb_serialnumber`
		if [ "x$serialnumber" = "x" ];then
			serialnumber=`cat /proc/cmdline | tr ' ' '\n' | grep 'snum' | awk -F "=" '{print $2}'`
		fi
		start_adb $serialnumber
		;;
	stop)
		printf "Stopping adbd "
		stop_adb
		[ $? -eq 0 ] && echo "OK" || echo "FAIL"
		;;
	restart|reload)
		"$0" stop
		"$0" start
		;;
	*)
		echo "Usage: $0 {start|stop|restart}"
		exit 1
		;;
esac
