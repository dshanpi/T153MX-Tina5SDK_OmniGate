# Network interfaces for the T153 omnigate board.

auto lo
iface lo inet loopback

auto eth0
iface eth0 inet dhcp
  pre-up /etc/network/nfs_check
  wait-delay 15
  hostname $(hostname)
  udhcpc_opts -T 1 -t 3 -A 3

auto eth1
iface eth1 inet dhcp
  pre-up /etc/network/nfs_check
  wait-delay 15
  hostname $(hostname)
  udhcpc_opts -T 1 -t 3 -A 3
