#!/bin/sh

NAME=omnigate-web
PIDFILE=/var/run/$NAME.pid
LOGFILE=/var/log/$NAME.log
DAEMON=/usr/bin/python3
APP=/usr/lib/omnigate-web/app.py

[ -r /etc/default/omnigate-web ] && . /etc/default/omnigate-web
ENABLED=${ENABLED:-1}
LISTEN_ADDRESS=${LISTEN_ADDRESS:-0.0.0.0}
LISTEN_PORT=${LISTEN_PORT:-80}

start()
{
	if [ "$ENABLED" != "1" ]; then
		echo "$NAME is disabled"
		return 0
	fi
	if [ -s "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; then
		echo "$NAME is already running"
		return 0
	fi
	mkdir -p /var/log /var/lib/omnigate/eds /var/run
	chmod 0700 /var/lib/omnigate/eds
	echo "Starting $NAME..."
	OMNIGATE_LISTEN_ADDRESS="$LISTEN_ADDRESS" \
	OMNIGATE_LISTEN_PORT="$LISTEN_PORT" \
		start-stop-daemon -S -b -m -p "$PIDFILE" -x "$DAEMON" \
		-- "$APP" >>"$LOGFILE" 2>&1
}

stop()
{
	echo "Stopping $NAME..."
	start-stop-daemon -K -p "$PIDFILE" -R 5
	rm -f "$PIDFILE"
}

case "$1" in
	start) start ;;
	stop) stop ;;
	restart) stop; start ;;
	status)
		if [ -s "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; then
			echo "$NAME is running (pid $(cat "$PIDFILE"))"
		else
			echo "$NAME is stopped"
			exit 1
		fi
		;;
	*)
		echo "Usage: $0 {start|stop|restart|status}"
		exit 1
		;;
esac
