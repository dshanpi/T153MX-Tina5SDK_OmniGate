config BR2_PACKAGE_SOEM
	bool "soem"
	depends on BR2_TOOLCHAIN_HAS_THREADS
	help
	  SOEM is a small, portable EtherCAT MainDevice (master) library.
	  This package installs libsoem and the upstream diagnostic/sample
	  programs, including slaveinfo, simple_ng and eepromtool.

	  https://github.com/OpenEtherCATsociety/SOEM

comment "soem needs a toolchain w/ threads"
	depends on !BR2_TOOLCHAIN_HAS_THREADS
