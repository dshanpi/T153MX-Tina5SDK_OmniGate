config BR2_PACKAGE_THINGSBOARD_GATEWAY
	bool "thingsboard-gateway"
	depends on BR2_PACKAGE_HOST_RUSTC_TARGET_ARCH_SUPPORTS
	select BR2_PACKAGE_PYTHON3
	select BR2_PACKAGE_PYTHON3_SSL
	select BR2_PACKAGE_PYTHON3_SQLITE
	select BR2_PACKAGE_PYTHON3_ZLIB
	select BR2_PACKAGE_PYTHON_CAN
	select BR2_PACKAGE_PYTHON_CRYPTOGRAPHY
	select BR2_PACKAGE_PYTHON_DATEUTIL
	select BR2_PACKAGE_PYTHON_JSONPATH_RW
	select BR2_PACKAGE_PYTHON_ORJSON
	select BR2_PACKAGE_PYTHON_PACKAGING
	select BR2_PACKAGE_PYTHON_PSUTIL
	select BR2_PACKAGE_PYTHON_PYSOCKS
	select BR2_PACKAGE_PYTHON_PYYAML
	select BR2_PACKAGE_PYTHON_REGEX
	select BR2_PACKAGE_PYTHON_REQUESTS
	select BR2_PACKAGE_PYTHON_SERIAL
	select BR2_PACKAGE_PYTHON_SERIAL_ASYNCIO
	select BR2_PACKAGE_PYTHON_SERVICE_IDENTITY
	select BR2_PACKAGE_PYTHON_SETUPTOOLS
	select BR2_PACKAGE_PYTHON_SIMPLEJSON
	help
	  ThingsBoard IoT Gateway with MQTT cloud transport and OmniGate
	  templates for one Modbus RTU and two SocketCAN/CAN-FD ports.

	  Runtime package installation is deliberately disabled. All required
	  modules are built into the firmware for reproducible deployments.

	  https://github.com/thingsboard/thingsboard-gateway

comment "thingsboard-gateway needs host Rust support for this target"
	depends on !BR2_PACKAGE_HOST_RUSTC_TARGET_ARCH_SUPPORTS
