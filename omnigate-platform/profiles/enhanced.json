{
  "$schema": "../schemas/runtime-profile.schema.json",
  "schema_version": 1,
  "id": "enhanced",
  "display_name": "OmniGate Enhanced",
  "target_class": "container-capable-edge",
  "components": [
    "omnigate-core",
    "omnigate-web",
    "omnigate-hmi",
    "omnigate-supervisor",
    "omnigate-ethercat",
    "node-red-profile",
    "platform-contracts"
  ],
  "services": ["omnigate-web", "omnigate-hmi", "omnigate-supervisor", "node-red"],
  "optional_features": ["canopen", "modbus-rtu", "ethercat", "cellular", "mqtt-rules"],
  "containers": true,
  "node_red": true,
  "persistence": {
    "data_root": "/var/lib/omnigate",
    "database": "edge.db",
    "atomic_configuration_writes": true
  },
  "container_policy": {
    "direct_hardware_devices": [],
    "drop_all_capabilities": true,
    "no_new_privileges": true,
    "read_only_root": true,
    "node_red_memory_mb": 384,
    "node_red_cpu_cores": 1.5
  }
}
