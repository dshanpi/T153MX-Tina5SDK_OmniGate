[
  {
    "id": "omnigate-tab",
    "type": "tab",
    "label": "OmniGate normalized telemetry",
    "disabled": false,
    "info": "Consume the stable OmniGate MQTT contract. Direct hardware access is intentionally disabled."
  },
  {
    "id": "omnigate-mqtt",
    "type": "mqtt-broker",
    "name": "OmniGate local broker",
    "broker": "${OMNIGATE_MQTT_HOST}",
    "port": "1883",
    "clientid": "nodered-edge-flows",
    "autoConnect": true,
    "usetls": false,
    "protocolVersion": "4",
    "keepalive": "60",
    "cleansession": true,
    "autoUnsubscribe": true
  },
  {
    "id": "telemetry-input",
    "type": "mqtt in",
    "z": "omnigate-tab",
    "name": "Normalized telemetry",
    "topic": "devices/+/telemetry",
    "qos": "1",
    "datatype": "json",
    "broker": "omnigate-mqtt",
    "nl": false,
    "rap": true,
    "rh": 0,
    "inputs": 0,
    "x": 180,
    "y": 100,
    "wires": [["telemetry-debug", "temperature-rule"]]
  },
  {
    "id": "telemetry-debug",
    "type": "debug",
    "z": "omnigate-tab",
    "name": "Telemetry (disabled by default)",
    "active": false,
    "tosidebar": true,
    "console": false,
    "tostatus": false,
    "complete": "payload",
    "targetType": "msg",
    "x": 480,
    "y": 100,
    "wires": []
  },
  {
    "id": "temperature-rule",
    "type": "switch",
    "z": "omnigate-tab",
    "name": "High temperature rule",
    "property": "payload.temperature",
    "propertyType": "msg",
    "rules": [{"t": "gte", "v": "80", "vt": "num"}],
    "checkall": "true",
    "repair": false,
    "outputs": 1,
    "x": 480,
    "y": 140,
    "wires": [["controlled-command"]]
  },
  {
    "id": "controlled-command",
    "type": "change",
    "z": "omnigate-tab",
    "name": "Create allow-listed notification",
    "rules": [
      {"t": "set", "p": "topic", "pt": "msg", "to": "\"devices/\" & $string(payload.device_id) & \"/commands\"", "tot": "jsonata"},
      {"t": "set", "p": "payload", "pt": "msg", "to": "{\"command\":\"thermal_alarm\",\"source\":\"node-red\",\"temperature\":payload.temperature}", "tot": "jsonata"}
    ],
    "x": 740,
    "y": 140,
    "wires": [["command-output"]]
  },
  {
    "id": "command-output",
    "type": "mqtt out",
    "z": "omnigate-tab",
    "name": "Controlled command output",
    "topic": "",
    "qos": "1",
    "retain": "false",
    "respTopic": "",
    "contentType": "application/json",
    "userProps": "",
    "correl": "",
    "expiry": "",
    "broker": "omnigate-mqtt",
    "x": 1010,
    "y": 140,
    "wires": []
  },
  {
    "id": "health-endpoint",
    "type": "http in",
    "z": "omnigate-tab",
    "name": "Container health",
    "url": "/health",
    "method": "get",
    "upload": false,
    "swaggerDoc": "",
    "x": 160,
    "y": 180,
    "wires": [["health-payload"]]
  },
  {
    "id": "health-payload",
    "type": "change",
    "z": "omnigate-tab",
    "name": "Healthy",
    "rules": [{"t": "set", "p": "payload", "pt": "msg", "to": "{\"ok\":true,\"service\":\"node-red\"}", "tot": "json"}],
    "x": 350,
    "y": 180,
    "wires": [["health-response"]]
  },
  {
    "id": "health-response",
    "type": "http response",
    "z": "omnigate-tab",
    "name": "Health response",
    "statusCode": "200",
    "headers": {"content-type": "application/json"},
    "x": 550,
    "y": 180,
    "wires": []
  }
]
